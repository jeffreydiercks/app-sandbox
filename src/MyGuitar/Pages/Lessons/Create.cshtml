@page
@model MyGuitar.Pages.Lessons.CreateModel
@{
    ViewData["Title"] = "Add Lesson";
}

<h1 class="mb-4">Add lesson</h1>

<div class="card" style="max-width: 560px">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Lesson.Title" class="form-label"></label>
                <input asp-for="Lesson.Title" class="form-control" />
                <span asp-validation-for="Lesson.Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Lesson.Stage" class="form-label"></label>
                <input asp-for="Lesson.Stage" class="form-control" placeholder="e.g. Beginner, Stage 1" />
                <span asp-validation-for="Lesson.Stage" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Lesson.Status" class="form-label"></label>
                <select asp-for="Lesson.Status" asp-items="Html.GetEnumSelectList<MyGuitar.Models.LessonStatus>()" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Lesson.Notes" class="form-label"></label>
                <textarea asp-for="Lesson.Notes" class="form-control" rows="3"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
