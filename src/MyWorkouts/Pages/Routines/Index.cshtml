@page
@model MyWorkouts.Pages.Routines.IndexModel
@{
    ViewData["Title"] = "Routines";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Routines</h1>
    <a asp-page="Create" class="btn btn-primary">+ New routine</a>
</div>

@if (Model.Routines.Any())
{
    <div class="row g-3">
        @foreach (var routine in Model.Routines)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@routine.Name</h5>
                        @if (!string.IsNullOrWhiteSpace(routine.Description))
                        {
                            <p class="card-text text-muted small">@routine.Description</p>
                        }
                        <div class="d-flex gap-3 text-muted small">
                            <span>⏱ @routine.EstimatedMinutes min</span>
                            <span>💪 @routine.Exercises.Count exercise@(routine.Exercises.Count == 1 ? "" : "s")</span>
                        </div>
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <a asp-page="Run" asp-route-id="@routine.Id" class="btn btn-sm btn-primary">▶ Start</a>
                        <a asp-page="Details" asp-route-id="@routine.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-page="Edit" asp-route-id="@routine.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@routine.Id" class="btn btn-sm btn-outline-danger">Del</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center text-muted py-5">No routines yet. <a asp-page="Create">Create one!</a></div>
}
