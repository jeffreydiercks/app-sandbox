@page
@model MyWorkouts.Pages.Routines.LibraryModel
@using MyWorkouts.Models
@{
    ViewData["Title"] = "Routine Library";
}

<h1 class="mb-1">Routine library</h1>
<p class="text-muted mb-4">Browse pre-built routines and copy them to your collection.</p>

@if (!Model.Templates.Any())
{
    <p class="text-muted">No templates available.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var routine in Model.Templates)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@routine.Name</h5>
                        @if (!string.IsNullOrWhiteSpace(routine.Description))
                        {
                            <p class="card-text text-muted small">@routine.Description</p>
                        }
                        <p class="card-text small">
                            <span class="me-3">@routine.Exercises.Count exercise@(routine.Exercises.Count == 1 ? "" : "s")</span>
                            <span>~@routine.EstimatedMinutes min</span>
                        </p>
                        <div class="list-group list-group-flush mb-3">
                            @foreach (var ex in routine.Exercises.OrderBy(e => e.Order))
                            {
                                <div class="list-group-item px-0 py-1 d-flex justify-content-between">
                                    <span class="small">@ex.Order. @ex.Name</span>
                                    <span class="text-muted small">
                                        @if (ex.IsRepBased)
                                        {
                                            <span>@ex.Reps reps</span>
                                        }
                                        else
                                        {
                                            <span>@ex.DurationSeconds s</span>
                                        }
                                        @if (ex.Equipment != EquipmentType.Bodyweight)
                                        {
                                            <span class="ms-1 badge bg-secondary">@ex.Equipment.ToDisplayName()</span>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                        <form method="post" asp-page-handler="Copy">
                            <input type="hidden" name="routineId" value="@routine.Id" />
                            <button type="submit" class="btn btn-primary btn-sm">Copy to my routines</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
