@page
@model MyWorkouts.Pages.Routines.Exercises.CreateModel
@using MyWorkouts.Models
@{
    ViewData["Title"] = "Add Exercise";
}

<h1 class="mb-4">Add exercise</h1>

<div class="card" style="max-width: 580px">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Exercise.RoutineId" />

            <div class="mb-3">
                <label asp-for="Exercise.Name" class="form-label"></label>
                <input asp-for="Exercise.Name" class="form-control" />
                <span asp-validation-for="Exercise.Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Exercise.Equipment" class="form-label"></label>
                <select asp-for="Exercise.Equipment" asp-items="Html.GetEnumSelectList<EquipmentType>()" class="form-select"></select>
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" asp-for="Exercise.IsRepBased" id="IsRepBased" />
                <label class="form-check-label" for="IsRepBased">Rep-based (count reps instead of timing)</label>
            </div>

            <div class="row g-3 mb-3" id="row-duration">
                <div class="col-6">
                    <label asp-for="Exercise.DurationSeconds" class="form-label">Duration (sec)</label>
                    <input asp-for="Exercise.DurationSeconds" type="number" class="form-control" min="5" max="3600" />
                    <span asp-validation-for="Exercise.DurationSeconds" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3" id="row-reps" style="display:none">
                <div class="col-6">
                    <label asp-for="Exercise.Reps" class="form-label">Reps per set</label>
                    <input asp-for="Exercise.Reps" type="number" class="form-control" min="1" max="500" />
                    <span asp-validation-for="Exercise.Reps" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label asp-for="Exercise.Sets" class="form-label">Sets</label>
                    <input asp-for="Exercise.Sets" id="Sets" type="number" class="form-control" min="1" max="100" />
                    <span asp-validation-for="Exercise.Sets" class="text-danger small"></span>
                </div>
                <div class="col-6" id="row-intraset" style="display:none">
                    <label asp-for="Exercise.IntraSetRestSeconds" class="form-label">Rest between sets (sec)</label>
                    <input asp-for="Exercise.IntraSetRestSeconds" type="number" class="form-control" min="0" max="300" />
                    <span asp-validation-for="Exercise.IntraSetRestSeconds" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label asp-for="Exercise.RestSeconds" class="form-label">Rest after exercise (sec)</label>
                    <input asp-for="Exercise.RestSeconds" type="number" class="form-control" min="0" max="600" />
                    <span asp-validation-for="Exercise.RestSeconds" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-7">
                    <label asp-for="Exercise.PrescribedWeight" class="form-label">Prescribed weight</label>
                    <input asp-for="Exercise.PrescribedWeight" type="number" class="form-control" min="0" step="0.5" placeholder="Optional" />
                </div>
                <div class="col-5">
                    <label asp-for="Exercise.WeightUnit" class="form-label">Unit</label>
                    <select asp-for="Exercise.WeightUnit" class="form-select">
                        <option value="lbs">lbs</option>
                        <option value="kg">kg</option>
                    </select>
                </div>
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" asp-for="Exercise.IsOneSided" id="IsOneSided" />
                <label class="form-check-label" for="IsOneSided">One-sided (perform on left &amp; right separately)</label>
            </div>

            <div class="mb-3">
                <label asp-for="Exercise.Order" class="form-label"></label>
                <input asp-for="Exercise.Order" type="number" class="form-control" min="1" />
                <span asp-validation-for="Exercise.Order" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Exercise.Notes" class="form-label"></label>
                <textarea asp-for="Exercise.Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Routines/Details" asp-route-id="@Model.Exercise.RoutineId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            function updateRepMode() {
                var repBased = document.getElementById('IsRepBased').checked;
                document.getElementById('row-duration').style.display = repBased ? 'none' : '';
                document.getElementById('row-reps').style.display = repBased ? '' : 'none';
            }
            function updateSetsMode() {
                var sets = parseInt(document.getElementById('Sets').value, 10) || 1;
                document.getElementById('row-intraset').style.display = sets > 1 ? '' : 'none';
            }
            document.getElementById('IsRepBased').addEventListener('change', updateRepMode);
            document.getElementById('Sets').addEventListener('input', updateSetsMode);
            updateRepMode();
            updateSetsMode();
        })();
    </script>
}
