@page "{id}"
@model MyLists.Pages.Lists.ViewModel
@{
    ViewData["Title"] = Model.List?.Name ?? "List";
}

@if (Model.List is null)
{
    <p class="text-danger">List not found.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@Model.List.Name</h1>
        <a asp-page="/Lists/Items/Create" asp-route-listId="@Model.List.Id" class="btn btn-primary">+ Add item</a>
    </div>

    @if (Model.Items.Any())
    {
        <div class="list-group mb-3">
            @foreach (var item in Model.Items.OrderBy(i => i.IsCompleted).ThenBy(i => i.Title))
            {
                <div class="list-group-item d-flex align-items-center gap-3">
                    <form method="post" asp-page-handler="Toggle" class="mb-0">
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <input type="hidden" name="listId" value="@Model.List.Id" />
                        <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-success" : "btn-outline-secondary")">
                            @(item.IsCompleted ? "✓" : "○")
                        </button>
                    </form>
                    <div class="flex-grow-1 @(item.IsCompleted ? "text-muted text-decoration-line-through" : "")">
                        @item.Title
                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <div class="small text-muted">@item.Notes</div>
                        }
                    </div>
                    <div class="d-flex gap-1">
                        <a asp-page="/Lists/Items/Edit" asp-route-id="@item.Id" asp-route-listId="@Model.List.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-page="/Lists/Items/Delete" asp-route-id="@item.Id" asp-route-listId="@Model.List.Id" class="btn btn-sm btn-outline-danger">Del</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No items yet. <a asp-page="/Lists/Items/Create" asp-route-listId="@Model.List.Id">Add one!</a></p>
    }

    <a asp-page="Index" class="btn btn-outline-secondary mt-2">← Back</a>
}
