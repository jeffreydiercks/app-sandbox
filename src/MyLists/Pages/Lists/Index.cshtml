@page
@model MyLists.Pages.Lists.IndexModel
@{
    ViewData["Title"] = "Lists";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Lists</h1>
    <a asp-page="Create" class="btn btn-primary">+ New list</a>
</div>

@if (Model.Lists.Any())
{
    <div class="list-group">
        @foreach (var (list, openCount) in Model.Lists)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <a asp-page="View" asp-route-id="@list.Id" class="text-decoration-none fw-semibold flex-grow-1">
                    @list.Name
                </a>
                <div class="d-flex align-items-center gap-2">
                    @if (openCount > 0)
                    {
                        <span class="badge bg-primary rounded-pill">@openCount</span>
                    }
                    <a asp-page="Edit" asp-route-id="@list.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-page="Delete" asp-route-id="@list.Id" class="btn btn-sm btn-outline-danger">Del</a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center text-muted py-5">No lists yet. <a asp-page="Create">Create one!</a></div>
}
