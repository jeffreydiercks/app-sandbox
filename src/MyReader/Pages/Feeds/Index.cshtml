@page
@model MyReader.Pages.Feeds.IndexModel
@{
    ViewData["Title"] = "Feeds";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Feeds</h1>
    <a asp-page="Create" class="btn btn-primary">+ Add feed</a>
</div>

@if (Model.Feeds.Any())
{
    <div class="list-group">
        @foreach (var feed in Model.Feeds)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <a asp-page="View" asp-route-id="@feed.Id" class="text-decoration-none fw-semibold flex-grow-1">
                    @feed.Title
                    <div class="text-muted small">@feed.Url</div>
                </a>
                <div class="d-flex gap-2 ms-3 flex-shrink-0">
                    <a asp-page="Edit" asp-route-id="@feed.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-page="Delete" asp-route-id="@feed.Id" class="btn btn-sm btn-outline-danger">Del</a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center text-muted py-5">No feeds yet. <a asp-page="Create">Add one!</a></div>
}
