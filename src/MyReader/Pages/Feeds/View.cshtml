@page "{id}"
@model MyReader.Pages.Feeds.ViewModel
@{
    ViewData["Title"] = Model.Feed?.Title ?? "Feed";
}

@if (Model.Feed is null)
{
    <p class="text-danger">Feed not found.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">@Model.Feed.Title</h1>
            <small class="text-muted">@Model.Feed.Url</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Edit" asp-route-id="@Model.Feed.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
            <a asp-page="Index" class="btn btn-sm btn-outline-secondary">← Back</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    @if (Model.Articles.Any())
    {
        <div class="list-group">
            @foreach (var article in Model.Articles)
            {
                <div class="list-group-item @(article.IsRead ? "opacity-50" : "")">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1 me-3">
                            <a href="@article.Link" target="_blank" rel="noopener noreferrer" class="fw-semibold text-decoration-none">
                                @article.Title
                            </a>
                            @if (article.PublishedAt.HasValue)
                            {
                                <div class="text-muted small">@article.PublishedAt.Value.ToString("d MMM yyyy")</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(article.Summary))
                            {
                                <p class="text-muted small mb-0 mt-1">@(article.Summary.Length > 200 ? article.Summary[..200] + "…" : article.Summary)</p>
                            }
                        </div>
                        @if (!article.IsRead)
                        {
                            <form method="post" asp-page-handler="MarkRead" class="flex-shrink-0">
                                <input type="hidden" name="feedId" value="@Model.Feed.Id" />
                                <input type="hidden" name="guid" value="@article.Guid" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark read</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="text-muted text-center py-4">No articles found.</p>
    }
}
