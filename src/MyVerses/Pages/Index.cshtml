@page
@model IndexModel
@using MyVerses.Models
@{
    ViewData["Title"] = "Home";
    var categoryOrder = new[] { VerseCategory.Prayer, VerseCategory.Quote, VerseCategory.Excerpt };
    var categoryLabels = new Dictionary<VerseCategory, string>
    {
        [VerseCategory.Prayer]  = "Prayers",
        [VerseCategory.Quote]   = "Quotes",
        [VerseCategory.Excerpt] = "Excerpts",
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My Verses</h1>
    <a asp-page="/Verses/Index" class="btn btn-sm btn-outline-primary">View all</a>
</div>

@foreach (var category in categoryOrder)
{
    var verses = Model.VersesByCategory.GetValueOrDefault(category, []);
    var carouselId = $"carousel-{category.ToString().ToLower()}";
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">@categoryLabels[category]</h5>
            <small class="text-muted">@verses.Count verse@(verses.Count == 1 ? "" : "s")</small>
        </div>
        @if (verses.Count == 0)
        {
            <div class="card">
                <div class="card-body text-muted text-center py-4">
                    <p class="mb-1">No @categoryLabels[category].ToLower() yet.</p>
                    <a asp-page="/Verses/Create" class="btn btn-sm btn-outline-secondary">Add one</a>
                </div>
            </div>
        }
        else
        {
            <div id="@carouselId" class="carousel slide" data-bs-ride="false">
                <div class="carousel-inner">
                    @for (int i = 0; i < verses.Count; i++)
                    {
                        var verse = verses[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="card verse-card">
                                <div class="card-body">
                                    <h6 class="card-title">@verse.Title</h6>
                                    <p class="card-text verse-content">@verse.Content</p>
                                    @if (!string.IsNullOrEmpty(verse.Author))
                                    {
                                        <footer class="blockquote-footer mt-2">@verse.Author</footer>
                                    }
                                </div>
                                <div class="card-footer d-flex justify-content-between align-items-center">
                                    <small class="text-muted">@(i + 1) / @verses.Count</small>
                                    <a asp-page="/Verses/Details" asp-route-id="@verse.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (verses.Count > 1)
                {
                    <div class="d-flex justify-content-center gap-2 mt-2">
                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                data-bs-target="#@carouselId" data-bs-slide="prev">
                            &lsaquo; Prev
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" type="button"
                                data-bs-target="#@carouselId" data-bs-slide="next">
                            Next &rsaquo;
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}
