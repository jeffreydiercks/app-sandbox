@page "{id}"
@model MyVerses.Pages.Verses.DeleteModel
@{
    ViewData["Title"] = "Delete verse";
}

<h1 class="mb-4">Delete verse</h1>

<div class="row">
    <div class="col-md-8">
        <div class="alert alert-danger" role="alert">
            Are you sure you want to delete this verse? This cannot be undone.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Verse.Title</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Verse.Category</dd>

            @if (!string.IsNullOrEmpty(Model.Verse.Author))
            {
                <dt class="col-sm-3">Author</dt>
                <dd class="col-sm-9">@Model.Verse.Author</dd>
            }

            <dt class="col-sm-3">Content</dt>
            <dd class="col-sm-9" style="white-space: pre-wrap">@Model.Verse.Content</dd>
        </dl>

        <form method="post">
            <input type="hidden" asp-for="Verse.Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="Details" asp-route-id="@Model.Verse.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
