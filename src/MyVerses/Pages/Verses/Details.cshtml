@page "{id}"
@model MyVerses.Pages.Verses.DetailsModel
@{
    ViewData["Title"] = Model.Verse.Title;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="Index">Verses</a></li>
        <li class="breadcrumb-item active">@Model.Verse.Title</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h1 class="mb-0">@Model.Verse.Title</h1>
            <span class="badge bg-secondary fs-6">@Model.Verse.Category</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Verse.Author))
        {
            <p class="text-muted mb-3">— @Model.Verse.Author</p>
        }

        <blockquote class="blockquote border-start border-4 ps-3 my-4">
            <p style="white-space: pre-wrap">@Model.Verse.Content</p>
        </blockquote>

        <p class="text-muted small">
            Added @Model.Verse.CreatedAt.ToString("MMMM d, yyyy")
            @if (Model.Verse.UpdatedAt != Model.Verse.CreatedAt)
            {
                <span> · Edited @Model.Verse.UpdatedAt.ToString("MMMM d, yyyy")</span>
            }
        </p>

        <div class="d-flex gap-2 mt-3">
            <a asp-page="Edit" asp-route-id="@Model.Verse.Id" class="btn btn-outline-secondary">Edit</a>
            <a asp-page="Delete" asp-route-id="@Model.Verse.Id" class="btn btn-outline-danger">Delete</a>
            <a asp-page="Index" class="btn btn-link">← Back to list</a>
        </div>
    </div>
</div>
